# Người dùng tự điền. Không commit file .env.
# PRIVATE_KEY của PLATFORM_OWNER. Script deploy / upgrade / set-admin không in giá trị này.
PRIVATE_KEY=
# PRIVATE_KEY của PLATFORM_ADMIN (tách khỏi owner). mock-agents và thao tác admin dùng biến này.
ADMIN_PRIVATE_KEY=
# RPC của chain đích. foundry.toml map tên "platform" tới biến này (chain id 991).
RPC_URL=
# Tham chiếu: địa chỉ ví owner / admin (script không đọc; kiểm tra bằng cast wallet address).
ADDRESS=
ADMIN_ADDRESS=
# Tuỳ chọn. Để trống: không cấp admin lúc deploy (cấp sau bằng make set-admin hoặc tab Proxy).
PLATFORM_ADMIN=
# Tuỳ chọn. Để trống: HistoryIndex dùng precompile FullDB 0x…0107 (chi khi node co precompile).
# Neu createAgent revert 0x0107: make deploy-mock-fulldb, gan FULLDB=<dia chi in ra>, make deploy lai.
FULLDB=

# make set-admin (owner cấp hoặc thu PLATFORM_ADMIN)
ACCESS_PROXY=
ADMIN=
# true = addPlatformAdmin, false = removePlatformAdmin
ALLOW=

# make upgrade (owner nâng một proxy). CONTRACT cũng có thể truyền trên dòng lệnh: make upgrade CONTRACT=...
# PlatformAccess | HistoryIndex | AgentRegistry | BranchRegistry | AgentAccess
CONTRACT=
# Tuỳ chọn: calldata hex gọi kèm upgradeToAndCall (ví dụ reinitializer). Để trống: không gọi gì.
UPGRADE_CALL=

# make mock-agents — cần ADMIN_PRIVATE_KEY (hoặc PRIVATE_KEY nếu bạn cố ý dùng ví admin).
# MOCK_AGENT_COUNT=100
# MOCK_AGENT_START=0
